{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "python manage.py test --verbosity=2",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Crawl Seeds",
      "type": "shell",
      "command": "python manage.py crawl_seeds --all"
    },
    {
      "label": "Fetch Pending",
      "type": "shell",
      "command": "python manage.py fetch_pending --limit 10"
    }
  ]
}
