# ─────────────────────────────────────────────────────────────────────────────
# media_monitor — environment template
#
# Copy to `.env` on each server and fill in real values:   cp .env.example .env
# The real `.env` is gitignored and must NEVER be committed.
# Settings read this file: media_monitor/settings/{development,production}.py
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
# Generate a fresh key, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Production has NO default — it will fail to boot without this.
SECRET_KEY=change-me-generate-a-50-char-random-key

# False in production (production.py forces it off regardless).
DEBUG=False

# Comma-separated. Set to your server's domain / droplet IP.
ALLOWED_HOSTS=your-domain.com,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Dev default is SQLite. For the DigitalOcean Postgres, use a URL like:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://media_monitor:password@db:5432/media_monitor

# ── Platform integration ─────────────────────────────────────────────────────
# False (dev): platform_sync models are managed locally in DATABASE_URL above.
# True  (prod): platform_sync models are unmanaged and routed to PLATFORM_DB_URL,
#               the shared platform PostgreSQL. production.py forces this True.
PLATFORM_INTEGRATED=False
# Shared platform DB — required only when PLATFORM_INTEGRATED=True.
PLATFORM_DB_URL=postgres://platform_user:password@platform-host:5432/platform_db

# ── Celery broker / Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Elasticsearch (optional — search/indexing degrades gracefully if absent) ──
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=articles
ELASTICSEARCH_TIMEOUT=10

# ── Crawler tuning ───────────────────────────────────────────────────────────
CRAWLER_TIMEOUT=15
CRAWLER_USER_AGENT=MediaMonitorBot/1.0 (+https://your-domain.com/bot)
MAX_LINKS_PER_PAGE=50
POLITENESS_DELAY=1.0

# ── Search-API discovery keys (optional — leave blank to disable) ────────────
BING_API_KEY=
GOOGLE_NEWS_API_KEY=
GOOGLE_CSE_ID=

# ── Apify social monitoring (optional — leave token blank to disable) ─────────
# One token covers all platforms. Create a SeedSource with source_type=social
# and meta {"platform": "x", "query": "..."} to monitor a platform for keywords.
# Without a token, social seeds simply discover nothing (no error).
APIFY_API_TOKEN=
APIFY_MAX_ITEMS=50
APIFY_TIMEOUT=120
# Actor IDs per platform — override only if you switch to a different scraper.
#   x         : real keyword search.
#   facebook  : PAGE-based — no open keyword search on Facebook. Set the Pages to
#               watch per seed: meta.actor_input = {"startUrls":[{"url":"https://facebook.com/<page>"}]}
#   instagram : keyword is searched as a hashtag (IG has no free-text post search).
#   linkedin  : keyword post search, no login required. Defaults to the most
#               recent posts from the past month; to back-date set
#               meta.actor_input={"date_filter":""} (all time) or "past-week" etc.
APIFY_ACTOR_X=apidojo/tweet-scraper
APIFY_ACTOR_FACEBOOK=apify/facebook-posts-scraper
APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
APIFY_ACTOR_LINKEDIN=apimaestro/linkedin-posts-search-scraper-no-cookies

# ── Email (alerts) ───────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=Social Light <noreply@sociallight.africa>
# Default is the console backend (prints emails to logs). For production use
# Resend via Anymail (preferred):
#   EMAIL_BACKEND=anymail.backends.resend.EmailBackend
#   RESEND_API_KEY=re_xxx
# Or the SMTP fallback: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# with the EMAIL_HOST_* vars below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
# SMTP fallback (only if not using Anymail/Resend):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Integrations (optional) ──────────────────────────────────────────────────
# Sentry error tracking — leave blank to disable.
SENTRY_DSN=

# Shared secret for verifying inbound webhooks.
MEDIA_MONITOR_WEBHOOK_SECRET=
