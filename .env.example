# ─────────────────────────────────────────────────────────────────────────────
# media_monitor — environment template
#
# Copy to `.env` on each server and fill in real values:   cp .env.example .env
# The real `.env` is gitignored and must NEVER be committed.
# Settings read this file: media_monitor/settings/{development,production}.py
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
# Generate a fresh key, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Production has NO default — it will fail to boot without this.
SECRET_KEY=change-me-generate-a-50-char-random-key

# False in production (production.py forces it off regardless).
DEBUG=False

# Comma-separated. Set to your server's domain / droplet IP.
ALLOWED_HOSTS=your-domain.com,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Dev default is SQLite. For the DigitalOcean Postgres, use a URL like:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://media_monitor:password@db:5432/media_monitor

# ── Platform integration ─────────────────────────────────────────────────────
# False (dev): platform_sync models are managed locally in DATABASE_URL above.
# True  (prod): platform_sync models are unmanaged and routed to PLATFORM_DB_URL,
#               the shared platform PostgreSQL. production.py forces this True.
PLATFORM_INTEGRATED=False
# Shared platform DB — required only when PLATFORM_INTEGRATED=True.
PLATFORM_DB_URL=postgres://platform_user:password@platform-host:5432/platform_db

# ── Celery broker / Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Elasticsearch (optional — search/indexing degrades gracefully if absent) ──
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=articles
ELASTICSEARCH_TIMEOUT=10

# ── Crawler tuning ───────────────────────────────────────────────────────────
CRAWLER_TIMEOUT=15
CRAWLER_USER_AGENT=MediaMonitorBot/1.0 (+https://your-domain.com/bot)
MAX_LINKS_PER_PAGE=50
POLITENESS_DELAY=1.0

# ── Search-API discovery keys (optional — leave blank to disable) ────────────
BING_API_KEY=
GOOGLE_NEWS_API_KEY=
GOOGLE_CSE_ID=

# ── Email (alerts) ───────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=Social Light <noreply@sociallight.africa>
SERVER_EMAIL=noreply@sociallight.africa
# Default is the console backend (prints emails to the logs and sends nothing).
# For production switch to SMTP and fill in the host settings below. Any SMTP
# provider works — a hosted mail service or your own server:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Use TLS on port 587 or SSL on port 465. Set exactly one, never both.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20

# ── Integrations (optional) ──────────────────────────────────────────────────
# Sentry error tracking — leave blank to disable.
SENTRY_DSN=

# Shared secret for verifying inbound webhooks.
MEDIA_MONITOR_WEBHOOK_SECRET=
